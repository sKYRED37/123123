# Скопируйте эти переменные в панель bothost.ru:
# Настройки бота → Environment Variables

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ваш Telegram ID — владелец бота (обязательно, узнать можно у @userinfobot)
OWNER_ID=

# Ключ Anthropic API, если используется (необязательно)
ANTHROPIC_API_KEY=

# Папка с составами HotS относительно корня проекта (необязательно, по умолчанию hots_rosters)
HOTS_ROSTERS_DIR=hots_rosters
